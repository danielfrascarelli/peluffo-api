{
  "name": "peluffo-backend",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "prepare": "husky",
    "build": "nest build -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0 --report-unused-disable-directives",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:e2e": "jest --config test/jest-e2e.json",
    "test:all": "npm test && npm run test:e2e",
    "security": "npm audit --omit=dev --audit-level=high && gitleaks detect --source . --redact",
    "hash-password": "node scripts/hash-password.mjs"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.7",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/terminus": "11.1.1",
    "@nestjs/throttler": "6.7.1",
    "argon2": "0.45.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "compression": "1.8.2",
    "cookie-parser": "1.4.7",
    "helmet": "8.3.0",
    "joi": "18.3.0",
    "nestjs-pino": "5.3.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.7",
    "@types/compression": "1.8.1",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "lint-staged": "17.6.0",
    "pino-pretty": "13.2.0",
    "prettier": "3.9.10",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0"
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "@scarf/scarf": false,
    "argon2": false,
    "unrs-resolver": false
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "collectCoverageFrom": [
      "**/*.ts",
      "!**/*.module.ts",
      "!**/*.dto.ts",
      "!main.ts",
      "!**/*.spec.ts"
    ]
  },
  "overrides": {
    "@nestjs/swagger": {
      "js-yaml": "5.5.0"
    }
  }
}
