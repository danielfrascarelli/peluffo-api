# Copy to .env. Secrets: JWT_ACCESS_SECRET, JWT_REFRESH_SECRET.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Comma-separated browser origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:5173
# Express "trust proxy" value: hop count, "loopback", or a subnet list.
TRUST_PROXY=loopback
# At least 32 random characters each, and different from each other: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
# Lifetimes in seconds.
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
DATA_DIR=data
# Serves Swagger UI at /docs. Keep false in production.
SWAGGER_ENABLED=false
# Optional. Google Sheets access through a service account key; leave empty to disable.
GOOGLE_APPLICATION_CREDENTIALS=secrets/google-sa.json
GOOGLE_SHEET_ID=
