#!/usr/bin/env bash
#
# Reject a push whose outgoing commits do not carry the repo's declared git identity.
#
# The declaration is read from AGENTS.md, so the committed declaration stays
# authoritative and the hook cannot drift from it.
#
# Only outgoing commits are inspected. History that predates the rule is not
# rewritten to adopt it.
#
# Reference implementation. Copy into a consuming repo as .githooks/pre-push
# and install with: scripts/hooks/install.sh, which also copies lib/.
#
# Rule: standards/GIT.md, "Authorship".
#
set -euo pipefail

HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/agent-trailers.sh
source "$HOOK_DIR/lib/agent-trailers.sh"

repo_root="$(git rev-parse --show-toplevel)"
agents_file="$repo_root/AGENTS.md"

if [[ ! -f "$agents_file" ]]; then
  echo "pre-push: AGENTS.md not found. It must declare the repo git identity." >&2
  echo "          See standards/GIT.md 'Authorship'." >&2
  exit 1
fi

read_declared() {
  sed -nE "s/^[[:space:]]*-?[[:space:]]*$1:[[:space:]]*(.+)[[:space:]]*$/\1/p" "$agents_file" | head -1
}

declared_email="$(read_declared 'user\.email')"
declared_name="$(read_declared 'user\.name')"

if [[ -z "$declared_email" || -z "$declared_name" ]]; then
  echo "pre-push: AGENTS.md must declare both 'user.name:' and 'user.email:'." >&2
  echo "          See standards/GIT.md 'Authorship'." >&2
  exit 1
fi

# A merge performed by the hosting platform rewrites the committer, never the
# author. Allow those committers; the author check still applies.
committer_allowed() {
  case "$1" in
    "$declared_email") return 0 ;;
    noreply@github.com|*@users.noreply.github.com) return 0 ;;
    *) return 1 ;;
  esac
}

zero="0000000000000000000000000000000000000000"
status=0

while read -r _local_ref local_sha _remote_ref remote_sha; do
  [[ "$local_sha" == "$zero" ]] && continue          # branch deletion

  if [[ "$remote_sha" == "$zero" ]]; then
    # New branch: check every commit not already reachable from another remote ref.
    range=("$local_sha" --not --remotes)
  else
    range=("$remote_sha..$local_sha")
  fi

  while IFS=$'\t' read -r sha author_name author_email committer_email; do
    [[ -z "$sha" ]] && continue
    if [[ "$author_email" != "$declared_email" ]]; then
      echo "pre-push: ${sha:0:8} authored by <$author_email>, expected <$declared_email>." >&2
      status=1
    fi
    if [[ "$author_name" != "$declared_name" ]]; then
      echo "pre-push: ${sha:0:8} author name '$author_name', expected '$declared_name'." >&2
      status=1
    fi
    if ! committer_allowed "$committer_email"; then
      echo "pre-push: ${sha:0:8} committed by <$committer_email>, expected <$declared_email>." >&2
      status=1
    fi
  done < <(git log --format='%H%x09%an%x09%ae%x09%ce' "${range[@]}")

  if git log --format='%B' "${range[@]}" | agent_trailers_present; then
    echo "pre-push: an outgoing commit message contains an agent trailer or session link." >&2
    git log --format='%B' "${range[@]}" | agent_trailers_show >&2 || true
    status=1
  fi
done

if [[ "$status" -ne 0 ]]; then
  echo "" >&2
  echo "Fix with: git config user.name '$declared_name' && git config user.email '$declared_email'" >&2
  echo "          git rebase -i --exec 'git commit --amend --no-edit --reset-author'" >&2
  echo "See standards/GIT.md 'Authorship'." >&2
fi

exit "$status"
